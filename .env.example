# =========================================================================
# CONFIGURACIÓN SAFITE & RNDC - AGENTE DE DESPACHOS
# =========================================================================

# 1. Base de Datos MySQL (Hostinger)
# Nota: Habilita el acceso remoto a MySQL en tu panel de Hostinger (Remote MySQL -> %)
MYSQL_HOST=srvXXXX.hstgr.io
MYSQL_USER=uXXXXXX_safite
MYSQL_PASSWORD=tu_password_mysql_hostinger
MYSQL_DATABASE=uXXXXXX_safite_agent
MYSQL_PORT=3306
MYSQL_SSL=false

# 2. Seguridad y Cifrado de Credenciales
# Clave aleatoria de 32 caracteres para cifrar las contraseñas de Safite en MySQL
ENCRYPTION_KEY=clave_secreta_super_segura_32_caracteres_minimo!
# Clave del Administrador para generar enlaces de invitación (/api/admin/invitaciones)
ADMIN_KEY=clave_admin_secreta_12345
# Secreto para verificar la autenticidad del Cron de Vercel
CRON_SECRET=secreto_cron_vercel_seguro

# 3. URLs de SAFITE
SAFITE_API_URL=https://api.app.safiteapp.com/index.php
SAFITE_AUTH_URL=https://auth.safiteapp.com

# 4. Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_WEBHOOK_SECRET=token_secreto_webhook_telegram_opcional

# 5. WhatsApp Cloud API (Meta) - Para activar más adelante
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=token_verificacion_meta_seguro

# 6. Inteligencia Artificial y Transcripción de Voz
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# 7. URL de tu Aplicación en Vercel
VERCEL_PROJECT_URL=https://tu-proyecto.vercel.app

# 8. Renovación de tokens Safite (Playwright en Vercel, cron en Hostinger)
SAFITE_LOGIN_URL=https://app.safiteapp.com/login.html?nit=TU_NIT&keyCompany=TU_KEY
SAFITE_ID_EMPRESA=
# Chat de Telegram del admin para alertas de fallo (opcional)
ADMIN_TELEGRAM_CHAT_ID=
